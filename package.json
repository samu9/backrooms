{
  "name": "backrooms",
  "version": "1.0.0",
  "description": "Procedural, infinite Backrooms (Level 0) in the browser: three.js + GLSL, no asset files.",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web && tsc --noEmit -p server",
    "shot": "node web/scripts/shot.mjs",
    "doc": "node scripts/build-doc.mjs",
    "server": "node server/server.ts",
    "start": "npm run build && node server/server.ts",
    "test": "node tests/hunt.test.ts && node tests/ai.test.ts",
    "sim": "node tests/ai.sim.ts 30",
    "gen:fixtures": "node tests/parity/dump.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
